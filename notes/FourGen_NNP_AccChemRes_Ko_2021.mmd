& \mathbf{A} & & \vdots \\
& & & 1 \\
\hline 1 & \cdots & 1 & 0
\end{array}\right)\left(\begin{array}{c}
Q_{1} \\
\vdots \\
Q_{N_{\mathrm{atom}}} \\
\lambda
\end{array}\right)=\left(\begin{array}{c}
-\chi_{1} \\
\vdots \\
-\chi_{N_{\mathrm{atom}}} \\
\hline Q_{\mathrm{tot}}
\end{array}\right)
\]
