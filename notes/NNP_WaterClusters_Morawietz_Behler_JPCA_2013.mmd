\title{
A Density-Functional Theory-Based Neural Network Potential for Water Clusters Including van der Waals Corrections
}

\author{
Tobias Morawietz and Jörg Behler* \\ Lehrstuhl für Theoretische Chemie, Ruhr-Universität Bochum, 44780 Bochum, Germany
}
