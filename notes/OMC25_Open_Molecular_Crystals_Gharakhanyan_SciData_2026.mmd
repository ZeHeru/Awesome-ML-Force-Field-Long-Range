\author{
Vahe Gharakhanyan \({ }^{1 \|}{ }^{\text {® }}\), Luis Barroso-Luque \({ }^{1}\), YiYang \({ }^{2}\), Muhammed Shuaibi \({ }^{1}\), Kyle Michel \({ }^{1}\), Daniel S. Levine \({ }^{1}\), Misko Dzamba \({ }^{1}\), Xiang Fu \({ }^{1}\), Meng Gao \({ }^{1}\), Xingyu Liu \({ }^{3}\), Haoran \(\mathrm{Ni}^{2}\), Keian Noori \({ }^{3}\), Brandon M. Wood \({ }^{1}\), Matt Uyttendaele \({ }^{1}\), Arman Boromand \({ }^{3}\), C. Lawrence Zitnick \({ }^{1}\), Noa Marom \({ }^{2,4,5 \boxtimes}\), Zachary W. Ulissi \({ }^{1 \boxtimes}\) \& Anuroop Sriram \({ }^{1 \boxtimes}\)
