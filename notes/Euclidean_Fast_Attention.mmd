\[
\operatorname{EFA}(\mathcal{X}, \mathcal{R})_{m}=\frac{1}{4 \pi} \int_{S^{2}} \boldsymbol{\Phi}_{\mathbf{u}}\left(\mathbf{q}_{m}, \mathbf{r}_{m}\right)^{\top} \sum_{n=1}^{N} \overline{\boldsymbol{\Phi}_{\mathbf{u}}\left(\mathbf{k}_{n}, \mathbf{r}_{n}\right)} \mathbf{v}_{n}^{\top} \otimes \mathbf{Y}(\mathbf{u}) \mathrm{d} \mathbf{u},
